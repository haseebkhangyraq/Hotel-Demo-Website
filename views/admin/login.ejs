<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#14212B">
  <title>Hotel Login · Grand Aurelia Admin</title>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' fill='%2314212B'/%3E%3Cpath d='M32 12 46 50H38L32 31 26 50H18L32 12Z' fill='%23C5A46D'/%3E%3C/svg%3E">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Manrope:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css?v=1.1">
  <link rel="stylesheet" href="/css/admin.css?v=1.1">
</head>
<body class="admin-body page-admin-login" data-admin-page="admin-login">

<main class="admin-login">
  <div class="login-visual">
    <img src="/images/hero-dusk.jpg" alt="Grand Aurelia Hotel & Resort at dusk">
    <div class="login-visual-overlay"></div>
    <a href="/" class="login-brand">
      <svg viewBox="0 0 48 48" aria-hidden="true">
        <circle cx="24" cy="24" r="22.5" fill="none" stroke="currentColor" stroke-width="0.8"/>
        <path d="M24 10 34.5 38H28.7L24 23.4 19.3 38H13.5L24 10Z" fill="currentColor"/>
        <circle cx="24" cy="42.5" r="1.15" fill="currentColor"/>
      </svg>
      <span>
        <strong>GRAND AURELIA</strong>
        <em>Hotel &amp; Resort</em>
      </span>
    </a>
    <div class="login-quote">
      <span class="eyebrow light">Hotel Management</span>
      <p>“The finest hotels do not ask for attention. They simply make everything feel easy.”</p>
      <span class="login-quote-meta">Front Office · Islamabad</span>
    </div>
    <span class="login-visual-note">Demonstration environment · No real guest data</span>
  </div>

  <div class="login-panel">
    <div class="login-panel-inner">
      <a href="/" class="login-back"><i data-lucide="arrow-left"></i> Back to website</a>
      <span class="eyebrow">Grand Aurelia</span>
      <h1>Welcome <em>back.</em></h1>
      <p class="login-lede">Sign in to manage reservations, rooms, guests and the daily operations of the hotel.</p>

      <% if (error) { %>
        <div class="admin-flash error" role="alert">
          <i data-lucide="alert-circle"></i>
          <span><%= error %></span>
        </div>
      <% } %>

      <form action="/admin/login" method="post" class="login-form" novalidate>
        <div class="field">
          <label for="loginEmail">Email address</label>
          <input type="email" id="loginEmail" name="email" value="admin@grandaurelia.com" placeholder="you@grandaurelia.com" required autocomplete="username">
          <span class="field-error"></span>
        </div>
        <div class="field">
          <label for="loginPassword">Password</label>
          <div class="password-wrap">
            <input type="password" id="loginPassword" name="password" value="Aurelia@2026" placeholder="Your password" required autocomplete="current-password">
            <button type="button" class="password-toggle" id="passwordToggle" aria-label="Show password"><i data-lucide="eye"></i></button>
          </div>
          <span class="field-error"></span>
        </div>
        <button type="submit" class="btn btn-gold btn-block">Sign In <i data-lucide="arrow-right"></i></button>
      </form>

      <div class="login-demo">
        <span><i data-lucide="key-round"></i> Demo credentials</span>
        <p><strong>admin@grandaurelia.com</strong><br><strong>Aurelia@2026</strong></p>
        <small>Pre-filled for convenience. Change the password from Settings after signing in.</small>
      </div>

      <p class="login-foot">This is a fictional hotel and a demonstration administration system.</p>
    </div>
  </div>
</main>

<script src="/vendor/lucide/lucide.min.js"></script>
<script src="/js/admin.js"></script>
</body>
</html>
