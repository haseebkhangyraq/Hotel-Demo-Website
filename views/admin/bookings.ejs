<%- include('partials/head') %>

<div class="admin-page-head">
  <div>
    <span class="admin-eyebrow">Front office</span>
    <h1>Reservations</h1>
    <p>Every booking, from enquiry to departure. Search by reference, guest name or email.</p>
  </div>
  <div class="admin-actions">
    <a class="admin-btn admin-btn-ghost" href="/admin/rooms"><i data-lucide="bed-double"></i> Room board</a>
    <a class="admin-btn admin-btn-gold" href="/booking" target="_blank" rel="noopener"><i data-lucide="plus"></i> New reservation</a>
  </div>
</div>

<div class="admin-filter-bar">
  <div class="admin-tabs" role="tablist" aria-label="Filter reservations by status">
    <% const tabs = [
      ['all', 'All', counts.all],
      ['pending', 'Pending', counts.pending],
      ['confirmed', 'Confirmed', counts.confirmed],
      ['checked_in', 'In house', counts.checked_in],
      ['checked_out', 'Departed', counts.checked_out],
      ['cancelled', 'Cancelled', counts.cancelled]
    ]; %>
    <% tabs.forEach(function(tab) { %>
      <a class="admin-tab <%= status === tab[0] ? 'is-active' : '' %>" href="/admin/bookings?status=<%= tab[0] %><%= q ? '&q=' + encodeURIComponent(q) : '' %>">
        <%= tab[1] %><span><%= tab[2] %></span>
      </a>
    <% }); %>
  </div>
  <form class="admin-search" action="/admin/bookings" method="get" role="search">
    <input type="hidden" name="status" value="<%= status %>">
    <i data-lucide="search"></i>
    <input type="search" name="q" value="<%= q %>" placeholder="Reference, guest or email" aria-label="Search reservations">
    <button type="submit">Search</button>
  </form>
</div>

<section class="panel">
  <div class="panel-head">
    <div>
      <span class="panel-eyebrow"><%= bookings.length %> record<%= bookings.length === 1 ? '' : 's' %></span>
      <h2 class="panel-title"><%= status === 'all' ? 'All reservations' : status.replace('_', ' ') %></h2>
    </div>
    <% if (q) { %><a class="panel-link" href="/admin/bookings?status=<%= status %>">Clear search <i data-lucide="x"></i></a><% } %>
  </div>

  <% if (bookings.length) { %>
    <div class="table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Reference</th>
            <th>Guest</th>
            <th>Stay</th>
            <th>Room</th>
            <th>Total</th>
            <th>Payment</th>
            <th>Status</th>
            <th class="cell-action">View</th>
          </tr>
        </thead>
        <tbody>
          <% bookings.forEach(function(b) { %>
            <tr>
              <td><a class="table-ref" href="/admin/bookings/<%= b.id %>"><%= b.reference %></a></td>
              <td>
                <span class="table-strong"><%= b.guest_name %></span>
                <span class="table-sub"><%= b.email %></span>
              </td>
              <td>
                <span class="table-strong"><%= b.check_in %> → <%= b.check_out %></span>
                <span class="table-sub"><%= b.adults %> adult<%= b.adults === 1 ? '' : 's' %><%= b.children ? ' · ' + b.children + ' child' + (b.children === 1 ? '' : 'ren') : '' %></span>
              </td>
              <td>
                <span class="table-strong"><%= b.category_name %></span>
                <span class="table-sub"><%= b.rooms_count %> room<%= b.rooms_count === 1 ? '' : 's' %></span>
              </td>
              <td class="table-money"><%= money(b.total) %></td>
              <td><span class="badge pay-<%= b.payment_status %>"><%= b.payment_status %></span></td>
              <td><span class="badge <%= b.booking_status %>"><%= b.booking_status.replace('_', ' ') %></span></td>
              <td class="cell-action"><a class="admin-icon-btn" href="/admin/bookings/<%= b.id %>" aria-label="View <%= b.reference %>"><i data-lucide="arrow-up-right"></i></a></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="admin-empty">
      <i data-lucide="calendar-search"></i>
      <h3>No reservations found</h3>
      <p>Try a different status or clear your search.</p>
      <a class="admin-btn admin-btn-ghost" href="/admin/bookings">View all reservations</a>
    </div>
  <% } %>
</section>

<%- include('partials/foot') %>
