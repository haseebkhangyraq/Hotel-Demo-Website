<%- include('partials/head') %>

<div class="admin-page-head">
  <div>
    <span class="admin-eyebrow">Relationships</span>
    <h1>Guests</h1>
    <p>A record of everyone who has stayed with us, their preferences and their history.</p>
  </div>
  <div class="admin-actions">
    <form class="admin-search" action="/admin/guests" method="get" role="search">
      <i data-lucide="search"></i>
      <input type="search" name="q" value="<%= q %>" placeholder="Name or email" aria-label="Search guests">
      <button type="submit">Search</button>
    </form>
  </div>
</div>

<section class="panel">
  <div class="panel-head">
    <div>
      <span class="panel-eyebrow"><%= guests.length %> guest<%= guests.length === 1 ? '' : 's' %></span>
      <h2 class="panel-title"><%= q ? 'Search results' : 'Guest directory' %></h2>
    </div>
    <% if (q) { %><a class="panel-link" href="/admin/guests">Clear search <i data-lucide="x"></i></a><% } %>
  </div>
  <% if (guests.length) { %>
    <div class="table-wrap">
      <table class="admin-table">
        <thead>
          <tr><th>Guest</th><th>Contact</th><th>Nationality</th><th>Stays</th><th>Lifetime value</th><th>Last stay</th><th class="cell-action">Profile</th></tr>
        </thead>
        <tbody>
          <% guests.forEach(function(g) { %>
            <tr>
              <td>
                <span class="guest-cell">
                  <span class="admin-avatar small"><%= g.first_name.charAt(0) %><%= g.last_name.charAt(0) %></span>
                  <span>
                    <span class="table-strong"><%= g.first_name %> <%= g.last_name %><%= g.vip ? ' · VIP' : '' %></span>
                    <span class="table-sub">Guest since <%= dateLabel(String(g.created_at).slice(0, 10)) %></span>
                  </span>
                </span>
              </td>
              <td><span class="table-strong"><%= g.email %></span><span class="table-sub"><%= g.phone || 'No phone' %></span></td>
              <td><%= g.nationality || '—' %></td>
              <td><strong><%= g.stays %></strong></td>
              <td class="table-money"><%= money(g.spend) %></td>
              <td><%= g.last_stay ? g.last_stay : '—' %></td>
              <td class="cell-action"><a class="admin-icon-btn" href="/admin/guests/<%= g.id %>" aria-label="Open <%= g.first_name %>'s profile"><i data-lucide="arrow-up-right"></i></a></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="admin-empty"><i data-lucide="users"></i><h3>No guests found</h3><p>Try a different name or email address.</p></div>
  <% } %>
</section>

<%- include('partials/foot') %>
