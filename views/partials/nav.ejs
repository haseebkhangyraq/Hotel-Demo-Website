<header class="site-header" id="siteHeader" data-header>
  <div class="header-inner">
    <a href="/" class="brand" aria-label="Grand Aurelia Hotel & Resort — Home">
      <svg class="brand-mark" viewBox="0 0 48 48" aria-hidden="true">
        <circle cx="24" cy="24" r="22.5" fill="none" stroke="currentColor" stroke-width="0.8"/>
        <path d="M24 10 34.5 38H28.7L24 23.4 19.3 38H13.5L24 10Z" fill="currentColor"/>
        <circle cx="24" cy="42.5" r="1.15" fill="currentColor"/>
      </svg>
      <span class="brand-type">
        <span class="brand-name">GRAND AURELIA</span>
        <span class="brand-sub">HOTEL &amp; RESORT</span>
      </span>
    </a>

    <nav class="primary-nav" aria-label="Primary">
      <a class="nav-link <%= currentPath === '/' ? 'is-active' : '' %>" href="/">Home</a>
      <a class="nav-link <%= currentPath.startsWith('/rooms') ? 'is-active' : '' %>" href="/rooms">Rooms &amp; Suites</a>
      <a class="nav-link <%= currentPath.startsWith('/dining') ? 'is-active' : '' %>" href="/dining">Dining</a>
      <a class="nav-link <%= currentPath.startsWith('/experiences') ? 'is-active' : '' %>" href="/experiences">Experiences</a>
      <a class="nav-link <%= currentPath.startsWith('/facilities') ? 'is-active' : '' %>" href="/facilities">Facilities</a>
      <a class="nav-link <%= currentPath.startsWith('/events') ? 'is-active' : '' %>" href="/events">Events</a>
      <a class="nav-link <%= currentPath.startsWith('/gallery') ? 'is-active' : '' %>" href="/gallery">Gallery</a>
      <a class="nav-link <%= currentPath.startsWith('/offers') ? 'is-active' : '' %>" href="/offers">Offers</a>
      <a class="nav-link <%= currentPath.startsWith('/contact') ? 'is-active' : '' %>" href="/contact">Contact</a>
    </nav>

    <div class="header-actions">
      <a class="header-phone" href="tel:<%= settings.phone.replace(/[^+\d]/g, '') %>" aria-label="Call the hotel">
        <i data-lucide="phone" class="icon-sm"></i>
        <span><%= settings.phone %></span>
      </a>
      <a href="/booking" class="btn btn-nav">Book Now <i data-lucide="arrow-up-right" class="icon-xs"></i></a>
      <button class="menu-toggle" id="menuToggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobileMenu">
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobileMenu" aria-hidden="true">
  <div class="mobile-menu-inner">
    <div class="mobile-menu-head">
      <span class="eyebrow light">Menu</span>
      <button class="mobile-close" id="mobileClose" aria-label="Close menu"><i data-lucide="x"></i></button>
    </div>
    <nav class="mobile-nav" aria-label="Mobile">
      <a href="/"><span>01</span> Home</a>
      <a href="/rooms"><span>02</span> Rooms &amp; Suites</a>
      <a href="/dining"><span>03</span> Dining Menu</a>
      <a href="/experiences"><span>04</span> Experiences</a>
      <a href="/facilities"><span>05</span> Facilities</a>
      <a href="/events"><span>06</span> Meetings &amp; Events</a>
      <a href="/gallery"><span>07</span> Gallery</a>
      <a href="/offers"><span>08</span> Offers</a>
      <a href="/guest-services"><span>09</span> Guest Services</a>
      <a href="/contact"><span>10</span> Contact</a>
    </nav>
    <div class="mobile-menu-foot">
      <a href="/booking" class="btn btn-gold btn-block">Reserve Your Stay <i data-lucide="arrow-up-right" class="icon-xs"></i></a>
      <div class="mobile-contact">
        <a href="tel:<%= settings.phone.replace(/[^+\d]/g, '') %>"><%= settings.phone %></a>
        <a href="mailto:<%= settings.email %>"><%= settings.email %></a>
      </div>
      <p><%= settings.address %>, <%= settings.city %>, <%= settings.country %></p>
    </div>
  </div>
  <div class="mobile-menu-image" aria-hidden="true">
    <img src="/images/resort-01.jpg" alt="">
    <span class="mobile-menu-caption">The Margalla Hills, at first light.</span>
  </div>
</div>
