<%
  const title = 'Reservation ' + booking.reference + ' — Grand Aurelia Hotel & Resort';
  const metaDescription = 'Your Grand Aurelia reservation is confirmed. Review your stay details, payment summary and arrival information.';
  const nights = Math.max(1, Math.round((new Date(booking.check_out) - new Date(booking.check_in)) / 86400000));
  const extraNames = (booking.services || []).map(function(id) {
    const found = (services || []).find(function(s) { return s.id === id; });
    return found ? found.name : id;
  });
  const breakfast = breakfastPlans[booking.breakfast_plan] || breakfastPlans.none;
  const transfer = transfers[booking.airport_transfer] || transfers.none;
  const paymentLabels = {
    cash_at_hotel: 'Pay at the hotel',
    demo_card: 'Paid now · demo card',
    pay_at_checkout: 'Pay at check-out'
  };
  const paymentStatusLabels = { paid: 'Paid', pending: 'Payment pending', refunded: 'Refunded' };
  const statusLabels = {
    confirmed: 'Confirmed', pending: 'Pending', checked_in: 'Checked in',
    checked_out: 'Checked out', cancelled: 'Cancelled'
  };
  const roomNumbers = (booking.rooms || []).map(function(r) { return r.room_number; });
  const totalGuests = booking.adults + (booking.children || 0);
%>
<%- include('partials/head') %>

<section class="confirmation-hero">
  <div class="container">
    <div class="confirm-icon"><i data-lucide="check"></i></div>
    <span class="eyebrow light centered">Reservation confirmed</span>
    <h1>Your stay is <em>arranged.</em></h1>
    <p>
      Thank you, <%= booking.guest_name.split(' ')[0] %>. A confirmation has been prepared for
      <strong style="color:rgba(255,255,255,.85);font-weight:500;"><%= booking.email %></strong>.
      We look forward to welcoming you to the hills.
    </p>
    <div class="confirm-ref">
      <i data-lucide="ticket"></i>
      Reference <%= booking.reference %>
    </div>
  </div>
</section>

<section class="confirmation-body">
  <div class="container">
    <article class="confirmation-card">
      <div class="confirm-top">
        <a href="/" class="brand" aria-label="Grand Aurelia — Home">
          <svg class="brand-mark" viewBox="0 0 48 48" aria-hidden="true">
            <circle cx="24" cy="24" r="22.5" fill="none" stroke="currentColor" stroke-width="0.8"/>
            <path d="M24 10 34.5 38H28.7L24 23.4 19.3 38H13.5L24 10Z" fill="currentColor"/>
            <circle cx="24" cy="42.5" r="1.15" fill="currentColor"/>
          </svg>
          <span class="brand-type">
            <span class="brand-name">GRAND AURELIA</span>
            <span class="brand-sub">HOTEL &amp; RESORT</span>
          </span>
        </a>
        <div class="confirm-status">
          <span>Reservation status</span>
          <strong><%= statusLabels[booking.booking_status] || booking.booking_status %></strong>
        </div>
      </div>

      <div class="confirm-grid">
        <div>
          <div class="confirm-section">
            <h3>Guest details</h3>
            <div class="confirm-detail-grid">
              <div class="confirm-detail"><span>Guest</span><strong><%= booking.guest_name %></strong></div>
              <div class="confirm-detail"><span>Email</span><strong><%= booking.email %></strong></div>
              <div class="confirm-detail"><span>Telephone</span><strong><%= booking.phone %></strong></div>
              <div class="confirm-detail"><span>Nationality</span><strong><%= booking.nationality || '—' %></strong></div>
            </div>
          </div>

          <div class="confirm-section">
            <h3>Your stay</h3>
            <div class="confirm-stay">
              <div class="confirm-stay-date">
                <span>Arrival</span>
                <strong><%= shortDate(booking.check_in) %></strong>
              </div>
              <div class="confirm-stay-line"></div>
              <div class="confirm-stay-nights"><%= nights %> night<%= nights === 1 ? '' : 's' %></div>
              <div class="confirm-stay-line"></div>
              <div class="confirm-stay-date">
                <span>Departure</span>
                <strong><%= shortDate(booking.check_out) %></strong>
              </div>
            </div>
            <div class="confirm-detail-grid">
              <div class="confirm-detail"><span>Room</span><strong><%= booking.category ? booking.category.name : (booking.category_name || 'Room') %></strong></div>
              <div class="confirm-detail"><span>Rooms reserved</span><strong><%= booking.rooms_count %></strong></div>
              <div class="confirm-detail"><span>Guests</span><strong><%= booking.adults %> adult<%= booking.adults === 1 ? '' : 's' %><%= booking.children ? ' · ' + booking.children + ' child' + (booking.children === 1 ? '' : 'ren') : '' %></strong></div>
              <div class="confirm-detail"><span>Room number<%= roomNumbers.length === 1 ? '' : 's' %></span><strong><%= roomNumbers.length ? roomNumbers.join(', ') : 'Allocated on arrival' %></strong></div>
            </div>
          </div>

          <div class="confirm-section">
            <h3>Included with your stay</h3>
            <div class="confirm-detail-grid">
              <div class="confirm-detail"><span>Dining plan</span><strong><%= breakfast.label %></strong></div>
              <div class="confirm-detail"><span>Arrival transfer</span><strong><%= transfer.label %></strong></div>
              <% if (extraNames.length) { %>
                <div class="confirm-detail" style="grid-column:1 / -1;"><span>Extras</span><strong><%= extraNames.join(' · ') %></strong></div>
              <% } %>
              <% if (booking.promo_code) { %>
                <div class="confirm-detail"><span>Promotional code</span><strong><%= booking.promo_code %></strong></div>
              <% } %>
            </div>
            <% if (booking.special_requests) { %>
              <div class="confirm-detail" style="margin-top:-10px;">
                <span>Special requests</span>
                <strong><%= booking.special_requests %></strong>
              </div>
            <% } %>
          </div>
        </div>

        <aside class="confirm-side">
          <h4>Payment summary</h4>
          <p>
            <%= paymentLabels[booking.payment_method] || booking.payment_method %> ·
            <span style="color:<%= booking.payment_status === 'paid' ? '#3C7A5B' : 'var(--gold-deep)' %>;font-weight:600;">
              <%= paymentStatusLabels[booking.payment_status] || booking.payment_status %>
            </span>
          </p>

          <div class="confirm-price-list" style="margin-top:22px;">
            <div class="summary-line"><span>Room · <%= nights %> night<%= nights === 1 ? '' : 's' %></span><span><%= money(booking.room_total) %></span></div>
            <% if (booking.extra_guest_total > 0) { %><div class="summary-line"><span>Extra guests</span><span><%= money(booking.extra_guest_total) %></span></div><% } %>
            <% if (booking.breakfast_total > 0) { %><div class="summary-line"><span>Dining plan</span><span><%= money(booking.breakfast_total) %></span></div><% } %>
            <% if (booking.services_total > 0) { %><div class="summary-line"><span>Extras &amp; transfer</span><span><%= money(booking.services_total) %></span></div><% } %>
            <% if (booking.discount_total > 0) { %><div class="summary-line discount"><span>Promotional discount</span><span>− <%= money(booking.discount_total) %></span></div><% } %>
            <div class="summary-line"><span>Service charge</span><span><%= money(booking.service_charge) %></span></div>
            <div class="summary-line"><span>GST</span><span><%= money(booking.tax_total) %></span></div>
            <div class="summary-line total"><span>Total</span><span><%= money(booking.total) %></span></div>
          </div>

          <ul>
            <li><i data-lucide="clock"></i> Check-in from <%= settings.checkin_time %>, check-out by <%= settings.checkout_time %>.</li>
            <li><i data-lucide="map-pin"></i> <%= settings.address %>, <%= settings.city %>.</li>
            <li><i data-lucide="phone"></i> Reservations: <%= settings.phone %>, answered day and night.</li>
            <li><i data-lucide="message-circle"></i> Message us on WhatsApp for arrival details or transfers.</li>
          </ul>

          <a class="btn btn-outline btn-block" href="https://wa.me/<%= settings.whatsapp_digits %>?text=<%= encodeURIComponent('Hello Grand Aurelia, I have reservation ' + booking.reference + ' and would like to confirm my arrival details.') %>" target="_blank" rel="noopener">
            Message the hotel <i data-lucide="arrow-up-right"></i>
          </a>
        </aside>
      </div>

      <div class="confirm-actions">
        <button type="button" class="btn btn-gold" id="printConfirmation">
          <i data-lucide="printer"></i> Print confirmation
        </button>
        <a class="btn btn-outline" href="/booking">Book another stay</a>
        <div class="spacer"></div>
        <a class="text-link" href="/contact">Questions? Write to us <i data-lucide="arrow-right" class="icon-xs"></i></a>
      </div>
    </article>

    <p class="confirmation-note">
      Please keep your reference <strong><%= booking.reference %></strong> to hand.
      This is a demonstration website — no real payment has been taken.
      <%= '' %>
      <a href="/guest-services">Pre-arrival requests</a> can be arranged before you travel.
    </p>
  </div>
</section>

<%- include('partials/footer', { pageScripts: '<script src="/js/confirmation.js"></script>' }) %>
