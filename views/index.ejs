<%
  const title = 'Grand Aurelia Hotel & Resort — A Quiet Kind of Luxury in Islamabad';
  const metaDescription = 'A five-star sanctuary in the Margalla Hills. Discover forty rooms and suites, five dining rooms, a Himalayan spa and effortless Pakistani hospitality.';
%>
<%- include('partials/head') %>

<!-- ============================ HERO ============================ -->
<section class="hero" aria-label="Welcome to Grand Aurelia">
  <div class="hero-media" data-parallax="0.18">
    <img src="<%= heroImage %>" alt="Grand Aurelia Hotel & Resort at dusk, framed by the Margalla Hills" fetchpriority="high">
  </div>

  <div class="hero-container">
    <div class="hero-body">
      <span class="eyebrow light hero-eyebrow" data-hero-fade>Islamabad · Pakistan</span>
      <h1 class="hero-title">
        <span class="reveal-line"><span>A quieter kind</span></span>
        <span class="reveal-line"><span>of <em>extraordinary.</em></span></span>
      </h1>
      <p class="hero-sub" data-hero-fade>
        Forty rooms and suites above the Margalla Hills, where Pakistani warmth meets an
        almost architectural sense of calm. Arrive as a guest. Leave a little changed.
      </p>
      <div class="hero-actions" data-hero-fade>
        <a href="/rooms" class="btn btn-gold">Explore Rooms &amp; Suites <i data-lucide="arrow-up-right"></i></a>
        <a href="/booking" class="btn btn-outline-light">Reserve Your Stay</a>
      </div>
    </div>

    <span class="hero-side-note">Est. <%= settings.established %> · Five Stars</span>
    <span class="hero-scroll" aria-hidden="true">Scroll <i></i></span>

    <!-- Booking widget -->
    <div class="booking-widget" id="heroBooking">
      <form action="/rooms" method="get" aria-label="Check availability">
        <div class="bw-field">
          <label for="heroCheckin">Arrival</label>
          <input type="date" id="heroCheckin" name="checkin" value="<%= dates.checkIn %>" min="<%= dates.checkIn %>" required>
        </div>
        <div class="bw-field">
          <label for="heroCheckout">Departure</label>
          <input type="date" id="heroCheckout" name="checkout" value="<%= dates.checkOut %>" min="<%= dates.checkOut %>" required>
        </div>
        <div class="bw-field">
          <label for="heroAdults">Adults</label>
          <select id="heroAdults" name="adults">
            <% for (let i = 1; i <= 6; i++) { %>
              <option value="<%= i %>" <%= i === 2 ? 'selected' : '' %>><%= i %></option>
            <% } %>
          </select>
        </div>
        <div class="bw-field">
          <label for="heroChildren">Children</label>
          <select id="heroChildren" name="children">
            <% for (let i = 0; i <= 4; i++) { %>
              <option value="<%= i %>"><%= i %></option>
            <% } %>
          </select>
        </div>
        <div class="bw-field">
          <label for="heroRooms">Rooms</label>
          <select id="heroRooms" name="rooms">
            <% for (let i = 1; i <= 4; i++) { %>
              <option value="<%= i %>"><%= i %></option>
            <% } %>
          </select>
        </div>
        <div class="bw-submit">
          <button type="submit" class="btn btn-gold btn-block">Check Availability</button>
        </div>
      </form>
      <div class="bw-note">
        <span>Best rate guaranteed when you book direct</span>
        <a href="https://wa.me/<%= settings.whatsapp_digits %>?text=<%= encodeURIComponent('Hello Grand Aurelia, I would like help with a reservation.') %>" target="_blank" rel="noopener">
          <i data-lucide="message-circle"></i> Prefer to speak with us?
        </a>
      </div>
    </div>
  </div>
</section>

<!-- ============================ INTRO STRIP ============================ -->
<section class="intro-strip" aria-label="Hotel highlights">
  <div class="container intro-strip-inner">
    <p>“The rare city hotel that feels like a country retreat.”</p>
    <div class="strip-meta">
      <span><i data-lucide="star"></i> Forbes Five-Star</span>
      <span><i data-lucide="map-pin"></i> 12 minutes from the city</span>
      <span><i data-lucide="clock"></i> Check-in from <%= settings.checkin_time %></span>
    </div>
  </div>
</section>

<!-- ============================ WELCOME ============================ -->
<section class="section welcome" id="welcome">
  <div class="container">
    <div class="welcome-grid">
      <div class="welcome-visual" data-reveal="fade-up">
        <span class="welcome-index" aria-hidden="true">01</span>
        <div class="welcome-visual-main">
          <img src="/images/resort-01.jpg" alt="The arrival court at Grand Aurelia" loading="lazy">
        </div>
        <div class="welcome-visual-sub">
          <img src="/images/dining-03.jpg" alt="A quiet corner of the Aurelia lobby" loading="lazy">
        </div>
        <span class="welcome-caption">The arrival court, late afternoon</span>
      </div>

      <div class="welcome-copy">
        <span class="eyebrow" data-reveal="fade-up">A welcome from Aurelia</span>
        <h2 class="section-heading" data-reveal="fade-up">Luxury, with the <em>volume turned down.</em></h2>
        <p class="lead" data-reveal="fade-up">
          We built Grand Aurelia around a simple idea: that the most memorable hospitality is
          felt rather than announced. Here, the garden is allowed to be quiet, the architecture
          is allowed to breathe, and your day is allowed to unfold at its own pace.
        </p>
        <blockquote class="welcome-quote" data-reveal="fade-up">
          “The finest hotels do not ask for attention. They simply make everything feel easy.”
        </blockquote>
        <div class="welcome-signature" data-reveal="fade-up">
          <span class="sig">Zara Qureshi</span>
          <span class="sig-meta">General Manager<br>Grand Aurelia Hotel &amp; Resort</span>
        </div>
        <div class="welcome-stats">
          <div class="welcome-stat" data-reveal="fade-up">
            <strong data-count="40">40</strong>
            <span>Rooms &amp; Suites</span>
          </div>
          <div class="welcome-stat" data-reveal="fade-up">
            <strong data-count="11">11</strong>
            <span>Room Categories</span>
          </div>
          <div class="welcome-stat" data-reveal="fade-up">
            <strong data-count="3">3</strong>
            <span>Acres of Gardens</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============================ ROOMS ============================ -->
<section class="section rooms-section" id="rooms">
  <div class="container">
    <div class="section-header">
      <div class="section-heading-wrap">
        <span class="eyebrow" data-reveal="fade-up">Stay with us</span>
        <h2 class="section-heading" data-reveal="fade-up">Rooms that feel like <em>a deep breath.</em></h2>
      </div>
      <div class="section-aside" data-reveal="fade-up">
        <p>Eleven categories, from a considered Standard Room to the Presidential Suite. Every one is a study in warm materials, soft light and quiet comfort.</p>
        <div class="slider-controls">
          <div class="slider-meta">
            <div class="slider-progress"><span id="roomsProgress"></span></div>
            <span class="slider-count" id="roomsCount">01 / 06</span>
          </div>
          <button class="swiper-btn" id="roomsPrev" aria-label="Previous rooms"><i data-lucide="chevron-left"></i></button>
          <button class="swiper-btn" id="roomsNext" aria-label="Next rooms"><i data-lucide="chevron-right"></i></button>
        </div>
      </div>
    </div>
  </div>

  <div class="container">
    <div class="swiper rooms-swiper" id="roomsSwiper">
      <div class="swiper-wrapper">
        <% rooms.forEach(function(room) { %>
          <div class="swiper-slide">
            <article class="room-card" data-reveal="fade-up">
              <a class="room-card-media" href="/rooms/<%= room.slug %>" aria-label="View <%= room.name %>">
                <img src="<%= room.cover_image %>" alt="<%= room.name %> at Grand Aurelia" loading="lazy">
                <span class="room-badge <%= room.availableRooms === 0 ? 'soldout' : room.availableRooms <= 2 ? 'limited' : '' %>">
                  <span class="dot"></span>
                  <%= room.availableRooms === 0 ? 'Fully booked' : room.availableRooms <= 2 ? 'Only ' + room.availableRooms + ' left' : 'Available' %>
                </span>
                <span class="room-card-arrow"><i data-lucide="arrow-up-right"></i></span>
              </a>
              <div class="room-card-body">
                <div class="room-card-kicker">
                  <span><%= room.view %></span>
                  <span><%= room.size_sqm %> m²</span>
                </div>
                <h3><a href="/rooms/<%= room.slug %>"><%= room.name %></a></h3>
                <p class="room-card-desc"><%= room.description %></p>
                <div class="room-card-specs">
                  <span><i data-lucide="bed-double"></i> <%= room.bed_type %></span>
                  <span><i data-lucide="users"></i> Up to <%= room.max_adults + room.max_children %></span>
                </div>
                <div class="room-card-foot">
                  <div class="room-price"><%= money(room.price) %><small>per night · excl. taxes</small></div>
                  <a class="room-card-link" href="/rooms/<%= room.slug %>">Discover <i data-lucide="arrow-up-right"></i></a>
                </div>
              </div>
            </article>
          </div>
        <% }); %>
      </div>
    </div>

    <div class="rooms-note" data-reveal="fade-up">
      <p>Not sure which room is right for you? Our reservations team knows every corner of the hotel.</p>
      <a href="/rooms" class="btn btn-outline">View All 11 Categories <i data-lucide="arrow-right"></i></a>
    </div>
  </div>
</section>

<!-- ============================ EXPERIENCES ============================ -->
<section class="section experiences-section" id="experiences">
  <div class="container">
    <div class="section-header">
      <div>
        <span class="eyebrow light" data-reveal="fade-up">Curated days</span>
        <h2 class="section-heading" data-reveal="fade-up">Experiences worth <em>remembering.</em></h2>
      </div>
      <div class="section-aside" data-reveal="fade-up">
        <p>Private dining in the kitchen garden. A sunrise trail through the Margalla Hills. A city discovered with someone who knows its quieter corners.</p>
        <a href="/experiences" class="text-link light">All Experiences <i data-lucide="arrow-up-right" class="icon-xs"></i></a>
      </div>
    </div>

    <div class="experiences-grid">
      <% experiences.forEach(function(exp, index) { %>
        <a class="exp-card <%= index === 0 ? 'large' : '' %>" href="/experiences" data-reveal="fade-up">
          <img src="<%= exp.image %>" alt="<%= exp.title %>" loading="lazy">
          <div class="exp-card-body">
            <div>
              <h3><%= exp.title %></h3>
              <p><%= exp.description %></p>
              <div class="exp-card-meta">
                <span><i data-lucide="clock"></i> <%= exp.duration %></span>
                <span><i data-lucide="tag"></i> From <%= money(exp.price) %></span>
              </div>
            </div>
            <span class="exp-arrow"><i data-lucide="arrow-up-right"></i></span>
          </div>
        </a>
      <% }); %>
    </div>
  </div>
</section>

<!-- ============================ FACILITIES ============================ -->
<section class="section facilities-section" id="facilities">
  <div class="container">
    <div class="section-header">
      <div>
        <span class="eyebrow" data-reveal="fade-up">The hotel</span>
        <h2 class="section-heading" data-reveal="fade-up">Everything, <em>quietly arranged.</em></h2>
      </div>
      <div class="section-aside" data-reveal="fade-up">
        <p>A 30-metre infinity pool, a Himalayan spa, three acres of gardens and a concierge team who seem to know what you need before you do.</p>
      </div>
    </div>

    <div class="facility-layout">
      <div class="facility-list" id="facilityList">
        <% facilities.forEach(function(facility, index) { %>
          <div class="facility-item <%= index === 0 ? 'is-active' : '' %>" data-facility="<%= index %>" data-hours="<%= facility.hours %>">
            <button type="button" class="facility-trigger" aria-expanded="<%= index === 0 ? 'true' : 'false' %>">
              <span class="facility-num"><%= String(index + 1).padStart(2, '0') %></span>
              <span class="facility-name"><%= facility.name %></span>
              <i data-lucide="arrow-up-right" class="facility-icon"></i>
            </button>
            <p class="facility-desc"><%= facility.short_description %></p>
          </div>
        <% }); %>
      </div>

      <div class="facility-visual" data-reveal="fade-up">
        <div class="facility-image-frame" id="facilityImages">
          <% facilities.forEach(function(facility, index) { %>
            <img src="<%= facility.image %>" alt="<%= facility.name %>" class="<%= index === 0 ? 'is-active' : '' %>" data-facility-image="<%= index %>" loading="lazy">
          <% }); %>
        </div>
        <div class="facility-visual-caption">
          <span id="facilityCaption"><i data-lucide="clock"></i> <%= facilities[0].hours %></span>
          <a href="/facilities">Explore Facilities <i data-lucide="arrow-up-right"></i></a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============================ DINING ============================ -->
<section class="section dining-preview" id="dining">
  <div class="container">
    <div class="dining-preview-grid">
      <div class="dining-visual" data-reveal="fade-up">
        <div class="dining-visual-main">
          <img src="/images/dining-01.jpg" alt="AURUM fine dining at Grand Aurelia" loading="lazy">
        </div>
        <div class="dining-visual-badge">
          <strong>05</strong>
          <span>Dining Rooms</span>
        </div>
      </div>

      <div class="dining-copy">
        <span class="eyebrow light" data-reveal="fade-up">The table</span>
        <h2 class="section-heading" data-reveal="fade-up">A menu shaped by <em>the season.</em></h2>
        <p class="lead" data-reveal="fade-up">
          Five distinctive rooms, one philosophy: cook what is finest today, and serve it with
          generosity. From breakfast at Noor to a chef’s table in the kitchen garden.
        </p>

        <div class="menu-preview-list" data-reveal="fade-up">
          <% menuPreview.forEach(function(item) { %>
            <div class="menu-preview-item">
              <h4><%= item.name %></h4>
              <span class="diet"><%= item.dietary.slice(0, 1).join('') %></span>
              <span class="dots"></span>
              <span class="price"><%= money(item.price) %></span>
            </div>
          <% }); %>
        </div>

        <div class="flex wrap gap-3" data-reveal="fade-up">
          <a href="/dining" class="btn btn-gold">Explore the Menu <i data-lucide="arrow-up-right"></i></a>
          <a href="/dining/menu/download" class="btn btn-outline-light">Download Sample Menu</a>
        </div>

        <div class="dining-meta-row" data-reveal="fade-up">
          <span><i data-lucide="clock"></i> Noor · 06:30 – 23:00</span>
          <span><i data-lucide="utensils"></i> In-room dining · 24 hours</span>
          <span><i data-lucide="sparkles"></i> Dietary needs welcomed</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============================ OFFERS ============================ -->
<section class="section offers-section" id="offers">
  <div class="container">
    <div class="section-header">
      <div>
        <span class="eyebrow" data-reveal="fade-up">Private invitations</span>
        <h2 class="section-heading" data-reveal="fade-up">A little more <em>Aurelia.</em></h2>
      </div>
      <div class="section-aside" data-reveal="fade-up">
        <p>Considered packages for weekends, honeymoons and long, unhurried stays. Each one is limited, and each one is quietly generous.</p>
        <a href="/offers" class="text-link">All Offers &amp; Packages <i data-lucide="arrow-up-right" class="icon-xs"></i></a>
      </div>
    </div>

    <div class="offers-grid">
      <% offers.forEach(function(offer) { %>
        <article class="offer-card" data-reveal="fade-up">
          <div class="offer-media">
            <img src="<%= offer.image %>" alt="<%= offer.title %>" loading="lazy">
            <span class="offer-discount"><%= offer.discount_label %></span>
          </div>
          <div class="offer-body">
            <span class="eyebrow"><%= offer.subtitle %></span>
            <h3><%= offer.title %></h3>
            <p><%= offer.description %></p>
            <% if (offer.promo_code) { %>
              <span class="offer-code"><i data-lucide="ticket" class="icon-xs"></i> <%= offer.promo_code %></span>
            <% } %>
            <a class="text-link" href="/booking?promo=<%= offer.promo_code || '' %>">Reserve this offer <i data-lucide="arrow-up-right" class="icon-xs"></i></a>
          </div>
        </article>
      <% }); %>
    </div>
  </div>
</section>

<!-- ============================ WELLNESS ============================ -->
<section class="wellness-band" id="wellness">
  <div class="wellness-bg" data-parallax="0.12">
    <img src="/images/spa-01.jpg" alt="The candlelit relaxation lounge at Aurelia Spa" loading="lazy">
  </div>
  <div class="container wellness-inner">
    <div class="wellness-card" data-reveal="fade-up">
      <span class="eyebrow light">Aurelia Spa</span>
      <h2 class="section-heading">The art of <em>doing less.</em></h2>
      <p class="lead">
        A 1,200 sqm sanctuary of warm stone, cedar and candlelight. Himalayan rituals,
        a traditional hammam and eight treatment suites — all designed to return you to yourself.
      </p>
      <ul class="wellness-features">
        <li><i data-lucide="check"></i> Signature Himalayan stone massage</li>
        <li><i data-lucide="check"></i> Traditional hammam ceremony</li>
        <li><i data-lucide="check"></i> Private couples’ suite &amp; thermal circuit</li>
        <li><i data-lucide="check"></i> Sunrise yoga on the garden terrace</li>
      </ul>
      <a href="/facilities#aurelia-spa" class="btn btn-gold">Discover the Spa <i data-lucide="arrow-up-right"></i></a>
    </div>
  </div>
  <span class="wellness-note">“Silence, warm stone, and the scent of cedar.”</span>
</section>

<!-- ============================ EVENTS ============================ -->
<section class="section events-home" id="events">
  <div class="container">
    <div class="events-home-grid">
      <div class="events-home-visual" data-reveal="fade-up">
        <div class="events-home-visual-main">
          <img src="/images/wedding-01.jpg" alt="The Grand Aurelia Ballroom set for a wedding" loading="lazy">
        </div>
        <div class="events-home-visual-sub">
          <img src="/images/event-03.jpg" alt="The Executive Boardroom" loading="lazy">
        </div>
      </div>

      <div>
        <span class="eyebrow" data-reveal="fade-up">Occasions</span>
        <h2 class="section-heading" data-reveal="fade-up">Moments, <em>beautifully held.</em></h2>
        <p class="lead" data-reveal="fade-up">
          From a board meeting for eight to a wedding for 800, our five venues and dedicated
          planners bring precision and warmth to every occasion.
        </p>
        <div class="events-capacity-list" data-reveal="fade-up">
          <% events.forEach(function(space) { %>
            <div class="events-capacity-item">
              <span><%= space.name %></span>
              <span>Up to <%= space.capacity_reception %> guests</span>
            </div>
          <% }); %>
        </div>
        <div class="flex wrap gap-3" data-reveal="fade-up">
          <a href="/events" class="btn btn-outline">Plan an Event <i data-lucide="arrow-up-right"></i></a>
          <a href="/events#enquiry" class="text-link">Speak with our team <i data-lucide="arrow-right" class="icon-xs"></i></a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============================ TESTIMONIALS ============================ -->
<section class="section testimonials-section" id="testimonials">
  <div class="container">
    <div class="text-center mb-5" data-reveal="fade-up">
      <span class="eyebrow light centered">In their words</span>
    </div>
    <div class="swiper testimonial-swiper" id="testimonialSwiper">
      <div class="swiper-wrapper">
        <% testimonials.forEach(function(t) { %>
          <div class="swiper-slide">
            <div class="testimonial-slide">
              <div class="testimonial-stars" aria-label="<%= t.rating %> out of 5 stars">
                <% for (let i = 0; i < t.rating; i++) { %><i data-lucide="star"></i><% } %>
              </div>
              <blockquote class="testimonial-quote">“<%= t.quote %>”</blockquote>
              <div class="testimonial-author">
                <strong><%= t.name %></strong>
                <span><%= t.stay %> · <%= t.location %></span>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
    <div class="testimonial-controls">
      <button class="swiper-btn" id="testimonialPrev" aria-label="Previous testimonial"><i data-lucide="chevron-left"></i></button>
      <span class="testimonial-count" id="testimonialCount">01 / <%= String(testimonials.length).padStart(2, '0') %></span>
      <button class="swiper-btn" id="testimonialNext" aria-label="Next testimonial"><i data-lucide="chevron-right"></i></button>
    </div>
  </div>
</section>

<!-- ============================ GALLERY ============================ -->
<section class="section gallery-preview" id="gallery">
  <div class="container">
    <div class="section-header">
      <div>
        <span class="eyebrow" data-reveal="fade-up">A look inside</span>
        <h2 class="section-heading" data-reveal="fade-up">The hotel, <em>in fragments.</em></h2>
      </div>
      <div class="section-aside" data-reveal="fade-up">
        <p>Light across the lobby at four o’clock. The pool before anyone arrives. Small details that make a stay feel like yours.</p>
        <a href="/gallery" class="text-link">Open the Gallery <i data-lucide="arrow-up-right" class="icon-xs"></i></a>
      </div>
    </div>

    <div class="gallery-preview-grid">
      <% gallery.forEach(function(item, index) { %>
        <button type="button" class="gallery-item" data-lightbox-group="home-gallery" data-full="<%= item.image %>" data-caption="<%= item.title %>" data-category="<%= item.category %>" data-reveal="image" aria-label="View <%= item.title %>">
          <img src="<%= item.image %>" alt="<%= item.title %>" loading="lazy">
          <span class="gallery-item-caption">
            <span><%= item.category %></span>
            <strong><%= item.title %></strong>
          </span>
          <span class="gallery-expand"><i data-lucide="maximize-2"></i></span>
        </button>
      <% }); %>
    </div>
  </div>
</section>

<!-- ============================ LOCATION ============================ -->
<section class="section location-section" id="location">
  <div class="container">
    <div class="location-grid">
      <div class="location-map" data-reveal="fade">
        <svg class="map-svg" viewBox="0 0 700 530" role="img" aria-label="Stylised map showing Grand Aurelia in the Margalla Hills, Islamabad">
          <rect width="700" height="530" fill="#EEE9DF"/>
          <path d="M-40 430 C120 360 210 410 330 340 C450 270 560 310 760 220" fill="none" stroke="#D8D0C0" stroke-width="28"/>
          <path d="M-40 430 C120 360 210 410 330 340 C450 270 560 310 760 220" fill="none" stroke="#F8F5EF" stroke-width="2" stroke-dasharray="10 10"/>
          <path d="M90 -30 C110 110 200 160 210 300 C218 400 150 470 120 560" fill="none" stroke="#DED6C6" stroke-width="14"/>
          <path d="M480 -20 C470 120 540 200 520 330 C505 430 580 480 600 560" fill="none" stroke="#DED6C6" stroke-width="14"/>
          <path d="M-20 150 C130 190 260 130 380 180 C500 230 620 160 720 190" fill="none" stroke="#E4DCCD" stroke-width="6"/>
          <path d="M250 0 L250 90 L340 90 L340 170 L420 170" fill="none" stroke="#E4DCCD" stroke-width="4"/>
          <path d="M0 320 L120 320 L120 250 L230 250" fill="none" stroke="#E4DCCD" stroke-width="4"/>
          <circle cx="120" cy="90" r="48" fill="#E5DDCE"/>
          <circle cx="575" cy="410" r="62" fill="#E9E2D4"/>
          <text x="42" y="94" class="map-label" font-size="14">Margalla Hills</text>
          <text x="515" y="414" class="map-label" font-size="14">Islamabad</text>
          <text x="250" y="368" class="map-label" font-size="13">Aurelia Boulevard</text>
          <text x="384" y="118" class="map-label" font-size="12">Kashmir Highway</text>
        </svg>
        <div class="map-marker">
          <span class="map-marker-pin"></span>
          <span class="map-marker-label">Grand Aurelia</span>
        </div>
        <div class="map-address">
          <h4><%= settings.short_name %></h4>
          <p><%= settings.address %><br><%= settings.city %>, <%= settings.country %></p>
          <a href="<%= settings.maps_url %>" target="_blank" rel="noopener">Open in Maps <i data-lucide="arrow-up-right"></i></a>
        </div>
      </div>

      <div class="location-copy">
        <span class="eyebrow" data-reveal="fade-up">Find us</span>
        <h2 class="section-heading" data-reveal="fade-up">Close to the city. <em>Far from the noise.</em></h2>
        <p data-reveal="fade-up">
          Set on the lower slopes of the Margalla Hills, Grand Aurelia is a twelve-minute drive
          from Islamabad’s diplomatic quarter and forty minutes from the airport — close enough
          for a dinner in town, far enough for the city to fall away.
        </p>
        <div class="location-facts" data-reveal="fade-up">
          <div class="location-fact">
            <span>Airport</span>
            <strong>40 min by car</strong>
          </div>
          <div class="location-fact">
            <span>City centre</span>
            <strong>12 min by car</strong>
          </div>
          <div class="location-fact">
            <span>Faisal Mosque</span>
            <strong>18 min by car</strong>
          </div>
          <div class="location-fact">
            <span>Margalla trails</span>
            <strong>5 min on foot</strong>
          </div>
        </div>
        <div class="location-actions" data-reveal="fade-up">
          <a href="<%= settings.maps_url %>" class="btn btn-outline" target="_blank" rel="noopener">Get Directions <i data-lucide="map-pin"></i></a>
          <a href="tel:<%= settings.phone.replace(/[^+\d]/g, '') %>" class="phone-link">
            <span>Reservations, 24 hours</span>
            <strong><%= settings.phone %></strong>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============================ CONTACT ============================ -->
<section class="contact-block" id="contact">
  <div class="container">
    <div class="contact-block-grid">
      <div>
        <span class="eyebrow light" data-reveal="fade-up">Begin a conversation</span>
        <h2 class="section-heading" data-reveal="fade-up">However you’d like to <em>arrive.</em></h2>
        <p class="lead" data-reveal="fade-up" style="color:rgba(255,255,255,.55);">
          Tell us a little about your plans and our reservations team will write back within
          one working day. For anything urgent, the telephone is always answered by a person.
        </p>
        <div class="contact-channels" data-reveal="fade-up">
          <div class="contact-channel">
            <span>Telephone</span>
            <a href="tel:<%= settings.phone.replace(/[^+\d]/g, '') %>"><%= settings.phone %></a>
          </div>
          <div class="contact-channel">
            <span>Email</span>
            <a href="mailto:<%= settings.email %>"><%= settings.email %></a>
          </div>
          <div class="contact-channel">
            <span>WhatsApp</span>
            <a href="https://wa.me/<%= settings.whatsapp_digits %>" target="_blank" rel="noopener"><%= settings.whatsapp %></a>
          </div>
        </div>
      </div>

      <div class="contact-form-card" data-reveal="fade-up">
        <h3>Write to us</h3>
        <p>A reservation, a celebration, or simply a question.</p>
        <form data-ajax-contact novalidate>
          <div class="form-grid">
            <div class="field">
              <label for="homeName">Your name</label>
              <input type="text" id="homeName" name="name" placeholder="Full name" required autocomplete="name">
              <span class="field-error"></span>
            </div>
            <div class="field">
              <label for="homeEmail">Email</label>
              <input type="email" id="homeEmail" name="email" placeholder="you@example.com" required autocomplete="email">
              <span class="field-error"></span>
            </div>
            <div class="field">
              <label for="homePhone">Phone <span style="text-transform:none;letter-spacing:0;">(optional)</span></label>
              <input type="tel" id="homePhone" name="phone" placeholder="+92" autocomplete="tel">
              <span class="field-error"></span>
            </div>
            <div class="field">
              <label for="homeSubject">Subject</label>
              <select id="homeSubject" name="subject">
                <option>Room reservation</option>
                <option>Dining reservation</option>
                <option>Wedding or event</option>
                <option>Spa &amp; wellness</option>
                <option>General enquiry</option>
              </select>
              <span class="field-error"></span>
            </div>
            <div class="field span-2">
              <label for="homeMessage">Message</label>
              <textarea id="homeMessage" name="message" placeholder="Tell us a little about your plans…" required></textarea>
              <span class="field-error"></span>
            </div>
          </div>
          <button type="submit" class="btn btn-gold btn-block mt-3">Send Message <i data-lucide="arrow-right"></i></button>
          <p class="form-status" data-status aria-live="polite"></p>
        </form>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
