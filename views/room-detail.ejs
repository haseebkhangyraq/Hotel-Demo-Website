<%
  const title = category.name + ' — Grand Aurelia Hotel & Resort';
  const metaDescription = category.description;
  const galleryImages = [...new Set([...(category.images || []), category.cover_image])].slice(0, 5);
  while (galleryImages.length < 5) galleryImages.push('/images/bath-04.jpg');
  const perNight = category.price;
  const stayTotal = perNight * Math.max(0, nights);
%>
<%- include('partials/head') %>

<section class="room-detail-hero">
  <div class="container">
    <div class="room-detail-top">
      <div>
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a><span>/</span><a href="/rooms">Rooms &amp; Suites</a><span>/</span><span><%= category.name %></span>
        </nav>
        <h1><%= category.name %></h1>
        <p class="room-tagline"><%= category.tagline %></p>
      </div>
      <div class="room-detail-price">
        <span>From</span>
        <strong><%= money(perNight) %></strong>
        <small>per night · excl. taxes &amp; service</small>
      </div>
    </div>
  </div>

  <div class="container">
    <div class="gallery-mosaic">
      <% galleryImages.forEach(function(img, index) { %>
        <button type="button" class="gallery-thumb" data-lightbox-group="room-<%= category.slug %>" data-full="<%= img %>" data-caption="<%= category.name %> · view <%= index + 1 %>" aria-label="View image <%= index + 1 %> of <%= category.name %>">
          <img src="<%= img %>" alt="<%= category.name %> interior, view <%= index + 1 %>" <%= index === 0 ? '' : 'loading="lazy"' %>>
        </button>
      <% }); %>
      <button type="button" class="gallery-more" data-lightbox-group="room-<%= category.slug %>" data-full="<%= galleryImages[0] %>" data-caption="<%= category.name %>">
        <i data-lucide="images"></i> View all images
      </button>
    </div>
  </div>
</section>

<section class="room-detail-body">
  <div class="container">
    <div class="room-detail-grid">
      <div>
        <div class="room-specs-band">
          <div class="room-spec">
            <i data-lucide="maximize"></i>
            <span>Size</span>
            <strong><%= category.size_sqm %> m² / <%= Math.round(category.size_sqm * 10.764) %> sq ft</strong>
          </div>
          <div class="room-spec">
            <i data-lucide="bed-double"></i>
            <span>Bedding</span>
            <strong><%= category.bed_type %></strong>
          </div>
          <div class="room-spec">
            <i data-lucide="users"></i>
            <span>Occupancy</span>
            <strong><%= category.max_adults %> adults · <%= category.max_children %> children</strong>
          </div>
          <div class="room-spec">
            <i data-lucide="mountain"></i>
            <span>Outlook</span>
            <strong><%= category.view %></strong>
          </div>
        </div>

        <div class="room-story">
          <span class="eyebrow">The room</span>
          <h2 class="mt-3">A considered <em>kind of space.</em></h2>
          <p class="lead"><%= category.description %></p>
          <p><%= category.long_description %></p>
          <p>
            Every stay includes daily housekeeping, high-speed Wi-Fi, access to the infinity pool
            and fitness centre, and the attention of our 24-hour concierge. Bathrobes, slippers
            and a pillow menu are provided as standard.
          </p>
        </div>

        <div class="amenities-block">
          <h3>Amenities &amp; comforts</h3>
          <p>Chosen for how they feel, not simply what they are.</p>
          <ul class="amenities-grid">
            <% category.amenities.forEach(function(amenity) { %>
              <li><i data-lucide="check"></i> <%= amenity %></li>
            <% }); %>
          </ul>
        </div>

        <div class="floorplan-card">
          <div>
            <h3>The layout</h3>
            <p>
              A clear, generous plan with a defined sleeping chamber, a sitting area and a
              beautifully appointed bathroom. Exact layouts vary slightly by floor and outlook.
            </p>
            <div class="floorplan-legend">
              <span><i style="background:#C5A46D;"></i> Sleeping</span>
              <span><i style="background:#DCD4C5;"></i> Living</span>
              <span><i style="background:#EEE9DF;"></i> Bathroom</span>
              <span><i style="background:#E5E0D5;"></i> Entry</span>
            </div>
          </div>
          <svg class="floorplan-svg" viewBox="0 0 360 250" role="img" aria-label="Indicative floor plan for the <%= category.name %>">
            <rect x="10" y="10" width="340" height="230" fill="#F8F5EF" stroke="#C9C2B5" stroke-width="1.5"/>
            <rect x="10" y="10" width="175" height="150" fill="#C5A46D" opacity=".28"/>
            <rect x="10" y="160" width="175" height="80" fill="#DCD4C5" opacity=".55"/>
            <rect x="185" y="10" width="165" height="95" fill="#EEE9DF"/>
            <rect x="185" y="105" width="165" height="135" fill="#E5E0D5"/>
            <rect x="185" y="105" width="80" height="70" fill="#F8F5EF" stroke="#C9C2B5" stroke-width="1"/>
            <line x1="10" y1="160" x2="185" y2="160" stroke="#C9C2B5" stroke-width="1.5"/>
            <line x1="185" y1="10" x2="185" y2="240" stroke="#C9C2B5" stroke-width="1.5"/>
            <line x1="185" y1="105" x2="350" y2="105" stroke="#C9C2B5" stroke-width="1.5"/>
            <line x1="265" y1="105" x2="265" y2="175" stroke="#C9C2B5" stroke-width="1"/>
            <rect x="60" y="55" width="76" height="58" fill="none" stroke="#A48D64" stroke-width="1"/>
            <circle cx="98" cy="84" r="12" fill="none" stroke="#A48D64" stroke-width="1"/>
            <rect x="215" y="130" width="40" height="26" fill="none" stroke="#A48D64" stroke-width="1"/>
            <text x="290" y="230" font-family="Manrope, sans-serif" font-size="8" fill="#8E887C">NOT TO SCALE</text>
          </svg>
        </div>
      </div>

      <!-- Booking aside -->
      <aside class="booking-aside">
        <div class="booking-card">
          <div class="booking-card-head">
            <div class="price">
              <%= money(perNight) %>
              <small>per night · excl. taxes</small>
            </div>
            <span class="avail"><span class="dot"></span> <%= availableRooms %> available</span>
          </div>

          <form action="/booking" method="get">
            <input type="hidden" name="room" value="<%= category.slug %>">
            <div class="field">
              <label for="detailCheckin">Arrival</label>
              <input type="date" id="detailCheckin" name="checkin" value="<%= dates.checkIn %>" min="<%= dates.checkIn %>" required>
            </div>
            <div class="field">
              <label for="detailCheckout">Departure</label>
              <input type="date" id="detailCheckout" name="checkout" value="<%= dates.checkOut %>" min="<%= dates.checkOut %>" required>
            </div>
            <div class="form-grid" style="gap:10px;">
              <div class="field">
                <label for="detailAdults">Adults</label>
                <select id="detailAdults" name="adults">
                  <% for (let i = 1; i <= category.max_adults; i++) { %><option value="<%= i %>" <%= i === Math.min(2, category.max_adults) ? 'selected' : '' %>><%= i %></option><% } %>
                </select>
              </div>
              <div class="field">
                <label for="detailChildren">Children</label>
                <select id="detailChildren" name="children">
                  <% for (let i = 0; i <= category.max_children; i++) { %><option value="<%= i %>"><%= i %></option><% } %>
                </select>
              </div>
            </div>
            <div class="field">
              <label for="detailRooms">Rooms</label>
              <select id="detailRooms" name="rooms">
                <% for (let i = 1; i <= Math.min(3, availableRooms || 1); i++) { %><option value="<%= i %>"><%= i %></option><% } %>
              </select>
            </div>
            <div class="booking-mini-total">
              <span><%= nights %> night<%= nights === 1 ? '' : 's' %> · room only</span>
              <strong><%= money(stayTotal) %></strong>
            </div>
            <button type="submit" class="btn btn-gold">Reserve This Room <i data-lucide="arrow-up-right"></i></button>
            <p class="booking-assurance"><i data-lucide="shield-check"></i> Best rate guaranteed · No prepayment on flexible rates</p>
          </form>

          <p class="booking-contact">
            Need a hand? Call <a href="tel:<%= settings.phone.replace(/[^+\d]/g, '') %>"><%= settings.phone %></a><br>
            or <a href="https://wa.me/<%= settings.whatsapp_digits %>?text=<%= encodeURIComponent('Hello Grand Aurelia, I would like to ask about the ' + category.name + '.') %>" target="_blank" rel="noopener">message us on WhatsApp</a>.
          </p>

          <ul class="room-detail-extras">
            <li><i data-lucide="calendar-check"></i> Free cancellation up to 48 hours before arrival</li>
            <li><i data-lucide="clock"></i> Check-in from <%= settings.checkin_time %> · check-out by <%= settings.checkout_time %></li>
            <li><i data-lucide="sparkles"></i> Breakfast, transfers and spa rituals can be added at the next step</li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</section>

<section class="similar-section">
  <div class="container">
    <div class="section-header">
      <div>
        <span class="eyebrow">You may also like</span>
        <h2 class="section-heading" style="font-size:clamp(36px,4vw,54px);">Other <em>addresses.</em></h2>
      </div>
      <a href="/rooms" class="text-link">All Rooms &amp; Suites <i data-lucide="arrow-up-right" class="icon-xs"></i></a>
    </div>
    <div class="similar-grid">
      <% similar.forEach(function(room) { %>
        <article class="room-card" data-reveal="fade-up">
          <a class="room-card-media" href="/rooms/<%= room.slug %>" aria-label="View <%= room.name %>">
            <img src="<%= room.cover_image %>" alt="<%= room.name %>" loading="lazy">
            <span class="room-card-arrow"><i data-lucide="arrow-up-right"></i></span>
          </a>
          <div class="room-card-body">
            <div class="room-card-kicker"><span><%= room.view %></span><span><%= room.size_sqm %> m²</span></div>
            <h3><a href="/rooms/<%= room.slug %>"><%= room.name %></a></h3>
            <p class="room-card-desc"><%= room.tagline %></p>
            <div class="room-card-foot">
              <div class="room-price"><%= money(room.price) %><small>per night</small></div>
              <a class="room-card-link" href="/rooms/<%= room.slug %>">Discover <i data-lucide="arrow-up-right"></i></a>
            </div>
          </div>
        </article>
      <% }); %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
