<%
  const title = 'Facilities — Grand Aurelia Hotel & Resort';
  const metaDescription = 'Discover Grand Aurelia’s infinity pool, Himalayan spa, fitness centre, business lounge, gardens and thoughtful guest services.';
%>
<%- include('partials/head') %>

<section class="page-hero">
  <div class="page-hero-image">
    <img src="/images/pool-01.jpg" alt="The infinity pool at Grand Aurelia, overlooking the Margalla Hills">
  </div>
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span>/</span><span>Facilities</span>
    </nav>
    <h1>Everything, <em>quietly arranged.</em></h1>
    <p class="hero-sub">
      A 30-metre infinity pool, a Himalayan spa, three acres of gardens and a team who seem to
      know what you need before you do. Explore the hotel, floor by floor.
    </p>
    <div class="page-hero-meta">
      <span><i data-lucide="building-2"></i> 10 facility groups</span>
      <span><i data-lucide="clock"></i> Many open 24 hours</span>
      <span><i data-lucide="accessibility"></i> Step-free throughout</span>
    </div>
  </div>
</section>

<section class="facilities-intro container">
  <div>
    <span class="eyebrow">The hotel</span>
    <h2 class="section-heading">A place to <em>do less.</em></h2>
  </div>
  <p>
    Some hotels are designed to impress. Ours is designed to settle you. Every facility has been
    considered for how it feels at seven in the morning and at midnight, in summer and in the
    quiet of winter.
  </p>
</section>

<div class="container">
  <nav class="facility-nav" aria-label="Facilities on this page">
    <% facilities.forEach(function(facility) { %>
      <a href="#<%= facility.slug %>"><%= facility.name %></a>
    <% }); %>
  </nav>
</div>

<section class="facility-blocks">
  <div class="container">
    <% facilities.forEach(function(facility, index) { %>
      <article class="facility-block" id="<%= facility.slug %>">
        <div class="facility-block-visual" data-reveal="fade-up">
          <div class="facility-block-image">
            <img src="<%= facility.image %>" alt="<%= facility.name %> at Grand Aurelia" loading="lazy">
          </div>
          <span class="facility-block-number" aria-hidden="true"><%= String(index + 1).padStart(2, '0') %></span>
        </div>
        <div class="facility-block-copy" data-reveal="fade-up">
          <span class="eyebrow"><%= facility.category %></span>
          <h2><%= facility.name %></h2>
          <p><%= facility.description %></p>
          <ul class="facility-feature-list">
            <% facility.features.forEach(function(feature) { %>
              <li><i data-lucide="check"></i> <%= feature %></li>
            <% }); %>
          </ul>
          <div class="flex wrap gap-3 align-center">
            <span class="facility-hours"><i data-lucide="clock"></i> <%= facility.hours %></span>
            <a class="text-link gold" href="/contact">Enquire <i data-lucide="arrow-up-right" class="icon-xs"></i></a>
          </div>
        </div>
      </article>
    <% }); %>
  </div>
</section>

<section class="services-section">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="eyebrow">At your service</span>
        <h2 class="section-heading" style="font-size:clamp(34px,4vw,50px);">The things you <em>needn’t ask for.</em></h2>
      </div>
      <a class="text-link" href="/guest-services">Guest Services <i data-lucide="arrow-up-right" class="icon-xs"></i></a>
    </div>
    <div class="services-grid">
      <% services.forEach(function(service) { %>
        <div class="service-tile">
          <i data-lucide="<%= service.icon %>"></i>
          <span><%= service.name %></span>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<section class="section-ivory" style="padding:0 0 110px;">
  <div class="container">
    <div class="rooms-note" style="margin-top:0;">
      <p>Every stay includes pool and fitness access, Wi-Fi, gardens and the attention of our concierge.</p>
      <a class="btn btn-outline" href="/booking">Reserve Your Stay <i data-lucide="arrow-up-right"></i></a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
